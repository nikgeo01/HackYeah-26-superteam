#!/bin/sh
# Rejects commit messages that carry tool or AI attribution lines.
# Enable once per clone: git config core.hooksPath .githooks
if grep -Eiq 'co-authored-by|generated with|claude|anthropic|🤖' "$1"; then
  echo "commit-msg: attribution lines are not allowed in this repository (see CONTRIBUTING.md)." >&2
  exit 1
fi
