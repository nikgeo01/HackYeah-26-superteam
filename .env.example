# Copy to .env (never commit .env).
# Devnet RPC for scripts and deploys; a free Helius devnet key avoids public rate limits.
RPC_URL=https://api.devnet.solana.com
# Path to the deployer wallet (it is the program's upgrade authority until --final).
ANCHOR_WALLET=~/.config/solana/id.json
# Proof prover (Dev B): Reclaim app credentials and a read-only GitHub token.
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
GITHUB_PAT=
