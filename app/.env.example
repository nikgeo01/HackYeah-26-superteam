# Copy to app/.env.local (never committed) and fill in.

# Helius devnet endpoint (ADR-09). Falls back to https://api.devnet.solana.com when empty.
VITE_RPC_URL=
VITE_CLUSTER=devnet
# Defaults to the address in app/src/idl/milestone_escrow.json when empty.
VITE_PROGRAM_ID=
# tUSDC mint printed by scripts/create-test-mint.ts.
VITE_TUSDC_MINT=
# Throwaway faucet mint-authority key (JSON byte array or base58). Test money only.
VITE_FAUCET_SECRET=
VITE_PROVER_URL=http://localhost:8787
VITE_DEFAULT_ATTESTOR=0x244897572368eadf65bfbc5aec98d8e5443a9072
# "true" embeds throwaway demo keys so one person can play every role.
VITE_DEMO_MODE=false
# JSON of labelled secret keys (Client, Worker, Arbiter 1-3, Passer-by), written by scripts/demo-setup.ts.
VITE_DEMO_ACTORS=
# Optional: pre-seeded deals listed on /demo, as JSON { "D1": "<deal address>", "D2": "..." }.
# Printed by scripts/seed-deals.ts. Only read when VITE_DEMO_MODE=true.
VITE_DEMO_DEALS=
